# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
# Artefacto intermedio del codegen de tipos (ver frontend/package.json,
# "codegen") -- el contrato versionado es frontend/src/lib/api-schema.ts,
# generado a partir de este archivo, no este archivo en sí.
frontend/openapi.json

# Env / secrets
.env
.env.*
!.env.example

# Data (raw/processed datasets stay local, not versioned)
ml/data/raw/*
ml/data/processed/*
!ml/data/raw/.gitkeep
!ml/data/processed/.gitkeep
# Excepción: dataset pequeño (512KB) y público (UCI), necesario para que el
# build de backend/Dockerfile no dependa de una descarga externa en CI.
!ml/data/raw/ai4i2020.csv

# ML artifacts
mlruns/
mlartifacts/
ml/mlflow.db
ml/evaluation/drift_report.html
*.pkl
*.pt
*.joblib

# SQLite (desarrollo local sin Docker, ver README)
*.db
*.db-journal

# Locust: salida cruda de cada corrida, no versionar (los números relevantes
# quedan resumidos a mano en load-testing/RESULTS.md)
load-testing/results*.csv

# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Terraform
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup
