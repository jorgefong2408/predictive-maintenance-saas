# Copiar a .env y ajustar. No versionar .env real (ver .gitignore).

# development (default) no valida nada. ENVIRONMENT=production activa el
# chequeo que rechaza arrancar con JWT_SECRET_KEY en su valor default.
ENVIRONMENT=development

# Rol restringido (predictmaint_app) — el que sirve requests reales, sujeto
# a Row-Level Security. MIGRATION_DATABASE_URL (rol admin/superusuario) es
# opcional acá: si no se define, las migraciones corren con DATABASE_URL —
# separar los dos roles solo importa una vez que RLS está activo (Postgres
# real, no este .env de ejemplo).
DATABASE_URL=postgresql+psycopg2://predictmaint_app:predictmaint_app_insecure_default@localhost:5432/predictmaint
MIGRATION_DATABASE_URL=postgresql+psycopg2://predictmaint:predictmaint@localhost:5432/predictmaint
APP_DB_PASSWORD=predictmaint_app_insecure_default

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

MLFLOW_TRACKING_URI=http://localhost:5000

REDIS_URL=redis://localhost:6379/0

# Semana 7 — job programado de reentrenamiento (ver backend/app/services/scheduler.py)
ENABLE_SCHEDULER=true
RETRAIN_INTERVAL_HOURS=24
