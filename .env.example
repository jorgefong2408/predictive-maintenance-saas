# Copiar a .env y ajustar. No versionar .env real (ver .gitignore).

DATABASE_URL=postgresql+psycopg2://predictmaint:predictmaint@localhost:5432/predictmaint
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

MLFLOW_TRACKING_URI=http://localhost:5000

REDIS_URL=redis://localhost:6379/0

# Semana 7 — job programado de reentrenamiento (ver backend/app/services/scheduler.py)
ENABLE_SCHEDULER=true
RETRAIN_INTERVAL_HOURS=24
